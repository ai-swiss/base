---
import ResourcePage from "../../components/ResourcePage.astro";
import { loadModel, resourceStaticPaths, type DocsResource } from "../../lib/model";

export function getStaticPaths() {
  return resourceStaticPaths(loadModel());
}

const { resource, target, aliasTo } = Astro.props as {
  resource: DocsResource;
  target: string;
  aliasTo: string | null;
};
if (aliasTo) return Astro.redirect(aliasTo, 301);
---

<ResourcePage resource={resource} target={target} lang="fr" />
