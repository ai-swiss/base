{
  "schema_version": "base.probe-scenario.v1",
  "id": "fresh-init-it",
  "title": "Una nuova root italiana instrada una richiesta ordinaria",
  "setup": {
    "kind": "init",
    "args": [
      "--language",
      "it",
      "--about",
      "Installiamo e manteniamo pompe di calore"
    ]
  },
  "prompt": "Voglio importare le mie procedure esistenti.",
  "expect": {
    "required": [
      {
        "type": "file_read",
        "path_ends_with": ".ai/routing/index.md"
      },
      {
        "type": "file_read",
        "path_matches": "/skills/processes/importer-l-existant/SKILL\\.md$"
      },
      {
        "type": "final_answer",
        "matches": "procedur|document|import"
      },
      {
        "type": "final_answer",
        "question_marks": 1
      }
    ],
    "forbidden": [
      {
        "type": "command",
        "includes": "base route"
      },
      {
        "type": "final_answer",
        "matches": "\\b(processo|frontmatter|router|routing|SKILL\\.md|AGENT\\.md)\\b"
      },
      {
        "type": "final_answer",
        "includes": "—"
      }
    ]
  }
}
