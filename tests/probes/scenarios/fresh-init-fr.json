{
  "schema_version": "base.probe-scenario.v1",
  "id": "fresh-init-fr",
  "title": "Une racine française neuve route une demande ordinaire",
  "setup": {
    "kind": "init",
    "args": [
      "--language",
      "fr",
      "--about",
      "Nous installons et entretenons des pompes à chaleur"
    ]
  },
  "prompt": "Je veux importer mes procédures existantes.",
  "expect": {
    "required": [
      {
        "type": "file_read",
        "path_ends_with": ".ai/routing/index.md"
      },
      {
        "type": "file_read",
        "path_matches": "/skills/processes/importer-l-existant/SKILL\\.md$"
      },
      {
        "type": "final_answer",
        "matches": "proc[eé]dure|document|import"
      },
      {
        "type": "final_answer",
        "question_marks": 1
      }
    ],
    "forbidden": [
      {
        "type": "command",
        "includes": "base route"
      },
      {
        "type": "final_answer",
        "matches": "\\b(process|frontmatter|routeur|routage|SKILL\\.md|AGENT\\.md)\\b"
      },
      {
        "type": "final_answer",
        "includes": "—"
      },
      {
        "type": "final_answer",
        "matches": "[\\u00A0\\u202F][:;!?]"
      }
    ]
  }
}
